// The server side, typechecked with the client.
//
// Without this the functions were only ever syntax-checked: Node strips types
// rather than checking them, so a field renamed in src/sync/wire.ts would
// compile on the client and quietly stop matching on the server. Being part
// of `tsc -b` makes that a build error instead of a sync bug.
//
// Resolution is "bundler" because that is what actually happens - Netlify
// bundles the functions with esbuild, and the .mts files import the client's
// .ts contract directly.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["netlify"]
}
